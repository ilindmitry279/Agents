# Copy this file to .env in this same day3/ folder, then replace the placeholders.
# Never commit .env: it holds your real key and is ignored by Git.

# Create a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Use the model ID your instructor gives you.
GROQ_MODEL=your-model-id-here
